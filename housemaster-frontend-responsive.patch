+}
+.back-to-list { display: none; }
+
 @media (max-width: 620px) {
   .topbar { padding: 12px 16px; align-items: flex-start; gap: 10px; }
   .topbar-right { gap: 8px; align-items: flex-end; flex-direction: column; }
-  nav.tabs { overflow-x: auto; padding: 0 8px; }
-  nav.tabs button { padding: 10px 11px; white-space: nowrap; }
   main.content { padding: 20px 16px 44px; }
   .announcement-detail h2 { font-size: 24px; }
   .announcement-card { padding: 16px; }
 }
+
+/* Below this width, swap the horizontal tab bar for a hamburger + off-canvas
+   drawer — a row of tabs stops being a usable nav pattern once it has to
+   scroll horizontally on a phone. */
+@media (max-width: 768px) {
+  nav.tabs { display: none; }
+  .menu-toggle { display: flex; }
+}
+
+/* Above the breakpoint, the drawer/backdrop/hamburger must never appear or
+   take up layout space, regardless of open state — nav.tabs is already the
+   default, always-visible nav there. */
+@media (min-width: 769px) {
+  .menu-toggle,
+  .nav-drawer,
+  .nav-backdrop {
+    display: none !important;
+  }
+}
+
+/* Tables: rather than reworking every panel's markup, let a table that's
+   wider than its container scroll horizontally as one block. Lightweight
+   and covers every existing/future table-using panel automatically. */
+@media (max-width: 768px) {
+  table { display: block; overflow-x: auto; white-space: nowrap; }
+}
+
+/* The login/accept-invite card had a fixed 360px width, which overflows
+   on phones narrower than that. */
+@media (max-width: 400px) {
+  .login-card { width: min(360px, 100%); padding: 24px 20px; }
+}
+
+/* Messages: side-by-side panes don't work on a phone-width screen — show
+   only the conversation list until one is opened/composing, then show
+   only that pane with a way back, matching a normal mobile chat app. */
+@media (max-width: 768px) {
+  .messages-layout { display: block; }
+  .messages-detail-pane { display: none; }
+  .messages-layout.showing-detail .messages-list-pane { display: none; }
+  .messages-layout.showing-detail .messages-detail-pane { display: block; }
+  .back-to-list { display: inline-block; margin-bottom: 14px; }
+}
