+/* Off-canvas mobile nav — hidden entirely above the breakpoint, where
+   nav.tabs (the existing horizontal bar) is used instead. */
+.nav-backdrop {
+  position: fixed;
+  inset: 0;
+  z-index: 20;
+  background: rgba(27, 35, 51, 0.5);
+}
+
+.nav-drawer {
+  display: flex;
+  flex-direction: column;
+  position: fixed;
+  top: 0;
+  left: 0;
+  bottom: 0;
+  z-index: 21;
+  width: min(78vw, 280px);
+  background: var(--navy);
+  border-right: 3px solid var(--gold);
+  padding: 8px 0 20px;
+  transform: translateX(-100%);
+  visibility: hidden;
+  transition: transform 0.2s ease;
+  overflow-y: auto;
+}
+.nav-drawer.open {
+  transform: translateX(0);
+  visibility: visible;
+}
+.nav-drawer-header {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  padding: 10px 16px 14px;
+  margin-bottom: 6px;
+  border-bottom: 1px solid rgba(250, 247, 240, 0.15);
+  color: var(--paper);
+  font-family: var(--font-display);
+  font-weight: 600;
+}
+.nav-drawer-close {
+  background: transparent;
+  border: none;
+  color: var(--paper);
+  padding: 2px 8px;
+}
+.nav-drawer-close:hover { background: rgba(250, 247, 240, 0.1); }
+.nav-drawer button:not(.nav-drawer-close) {
+  background: transparent;
+  border: none;
+  border-left: 3px solid transparent;
+  border-radius: 0;
+  color: rgba(250, 247, 240, 0.75);
+  text-align: left;
+  padding: 13px 20px;
+  font-size: 14px;
+}
+.nav-drawer button:not(.nav-drawer-close):hover { background: rgba(250, 247, 240, 0.06); }
+.nav-drawer button.active {
+  color: var(--paper);
+  background: rgba(250, 247, 240, 0.08);
+  border-left-color: var(--gold);
+}
+
 main.content {
   flex: 1;
   padding: 28px 24px 60px;
@@ -403,12 +491,61 @@ tbody tr:hover { background: var(--paper); }
 button.danger-solid { background: var(--stamp-red); border-color: var(--stamp-red); }
 button.danger-solid:hover { background: #7f2929; }
 
+.messages-layout {
+  display: grid;
+  grid-template-columns: 300px 1fr;
+  gap: 20px;
