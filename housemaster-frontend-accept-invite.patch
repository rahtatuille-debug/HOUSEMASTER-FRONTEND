diff --git a/src/panels/AcceptInvite.jsx b/src/panels/AcceptInvite.jsx
new file mode 100644
index 0000000..37eea50
--- /dev/null
+++ b/src/panels/AcceptInvite.jsx
@@ -0,0 +1,123 @@
+import { useEffect, useState } from 'react'
+import { api } from '../api.js'
+
+// Rendered for anyone who opens an /accept-invite/<token> link, whether or
+// not they're logged in elsewhere in the browser — this screen doesn't use
+// the authenticated app shell at all.
+export default function AcceptInvite({ token, onAccepted }) {
+  const [invite, setInvite] = useState(null)
+  const [loadError, setLoadError] = useState('')
+  const [loading, setLoading] = useState(true)
+
+  const [username, setUsername] = useState('')
+  const [password, setPassword] = useState('')
+  const [confirmPassword, setConfirmPassword] = useState('')
+  const [formError, setFormError] = useState('')
+  const [submitting, setSubmitting] = useState(false)
+
+  useEffect(() => {
+    let cancelled = false
+    api
+      .invites.preview(token)
+      .then((data) => {
+        if (!cancelled) setInvite(data)
+      })
+      .catch((err) => {
+        if (!cancelled) setLoadError(err.message || 'This invite link is invalid.')
+      })
+      .finally(() => {
+        if (!cancelled) setLoading(false)
+      })
+    return () => {
+      cancelled = true
+    }
+  }, [token])
+
+  async function handleSubmit(e) {
+    e.preventDefault()
+    setFormError('')
+    if (password !== confirmPassword) {
+      setFormError('Passwords do not match.')
+      return
+    }
+    setSubmitting(true)
+    try {
+      await api.invites.accept(token, { username, password })
+      onAccepted()
+    } catch (err) {
+      setFormError(err.message || 'Could not set up your account.')
+    } finally {
+      setSubmitting(false)
+    }
+  }
+
+  return (
+    <div className="login-wrap">
+      <div className="login-card">
+        <h1>HouseMaster</h1>
+        <p className="tagline">Set up your account</p>
+
+        {loading && <p className="hint">Checking your invite…</p>}
+
+        {!loading && loadError && (
+          <>
+            <div className="error-banner">{loadError}</div>
+            <p className="hint">
+              This link may have already been used or has expired. Ask a school admin to
+              send a new invite.
+            </p>
+          </>
+        )}
+
+        {!loading && invite && (
+          <>
+            <p className="hint" style={{ marginBottom: 18 }}>
+              You've been invited to join <strong>{invite.school_name}</strong> as a{' '}
+              <strong>{invite.role}</strong>. Set a username and password to continue.
+            </p>
+            {formError && <div className="error-banner">{formError}</div>}
+            <form onSubmit={handleSubmit}>
+              <div className="field">
+                <label htmlFor="invite-email">Email</label>
+                <input id="invite-email" value={invite.email} disabled />
+              </div>
+              <div className="field">
+                <label htmlFor="invite-username">Username</label>
+                <input
+                  id="invite-username"
+                  value={username}
+                  onChange={(e) => setUsername(e.target.value)}
+                  autoFocus
+                  required
+                />
+              </div>
+              <div className="field">
+                <label htmlFor="invite-password">Password</label>
+                <input
+                  id="invite-password"
+                  type="password"
+                  value={password}
+                  onChange={(e) => setPassword(e.target.value)}
+                  required
+                />
+              </div>
+              <div className="field">
+                <label htmlFor="invite-confirm-password">Confirm password</label>
+                <input
+                  id="invite-confirm-password"
+                  type="password"
+                  value={confirmPassword}
+                  onChange={(e) => setConfirmPassword(e.target.value)}
+                  required
+                />
+              </div>
+              <button type="submit" disabled={submitting} style={{ width: '100%' }}>
+                {submitting ? 'Setting up…' : 'Create account'}
+              </button>
+            </form>
+          </>
+        )}
+      </div>
+    </div>
+  )
+}
diff --git a/src/panels/Invites.jsx b/src/panels/Invites.jsx
new file mode 100644
index 0000000..b9eb13d
--- /dev/null
+++ b/src/panels/Invites.jsx
@@ -0,0 +1,142 @@
+import { useEffect, useState } from 'react'
+import { api } from '../api.js'
+
+export default function Invites() {
+  const [invites, setInvites] = useState([])
+  const [error, setError] = useState('')
+  const [loading, setLoading] = useState(true)
+
+  const [email, setEmail] = useState('')
+  const [role, setRole] = useState('teacher')
+  const [sending, setSending] = useState(false)
+
+  async function load() {
+    setLoading(true)
+    setError('')
+    try {
+      setInvites(await api.invites.list())
+    } catch (err) {
+      setError(err.message)
+    } finally {
+      setLoading(false)
+    }
+  }
+
+  useEffect(() => {
+    load()
+  }, [])
+
+  async function handleInvite(e) {
+    e.preventDefault()
+    if (!email.trim()) return
+    setSending(true)
+    setError('')
+    try {
+      await api.invites.create({ email: email.trim(), role })
+      setEmail('')
+      setRole('teacher')
+      load()
+    } catch (err) {
+      setError(err.message)
+    } finally {
+      setSending(false)
+    }
+  }
+
+  async function handleRevoke(id) {
+    try {
+      await api.invites.remove(id)
+      load()
+    } catch (err) {
+      setError(err.message)
+    }
+  }
+
+  function status(invite) {
+    if (invite.accepted_at) return { label: 'accepted', cls: 'finalized' }
+    if (new Date(invite.expires_at) <= new Date()) return { label: 'expired', cls: 'draft' }
+    return { label: 'pending', cls: 'reviewed' }
+  }
+
+  return (
+    <div>
+      <div className="panel-header">
+        <h2>Invites</h2>
+      </div>
+      {error && <div className="error-banner">{error}</div>}
+
+      <div className="card">
+        <h3 style={{ marginBottom: 14 }}>Invite staff</h3>
+        <form onSubmit={handleInvite} className="form-row" style={{ marginBottom: 4 }}>
+          <div className="field" style={{ marginBottom: 0 }}>
+            <label htmlFor="invite-email">Email</label>
+            <input
+              id="invite-email"
+              type="email"
+              value={email}
+              onChange={(e) => setEmail(e.target.value)}
+              placeholder="teacher@school.example"
+            />
+          </div>
+          <div className="field" style={{ marginBottom: 0 }}>
+            <label htmlFor="invite-role">Role</label>
+            <select id="invite-role" value={role} onChange={(e) => setRole(e.target.value)}>
+              <option value="teacher">Teacher</option>
+              <option value="admin">Admin</option>
+            </select>
+          </div>
+          <button type="submit" disabled={sending}>
+            {sending ? 'Sending…' : 'Send invite'}
+          </button>
+        </form>
+        <p className="hint">
+          They'll get an email with a link to set up their own username and password.
+        </p>
+      </div>
+
+      <div className="card">
+        <h3 style={{ marginBottom: 14 }}>Sent invites</h3>
+        {!loading && invites.length === 0 && (
+          <p className="hint">No invites sent yet.</p>
+        )}
+        {invites.length > 0 && (
+          <table>
+            <thead>
+              <tr>
+                <th>Email</th>
+                <th>Role</th>
+                <th>Status</th>
+                <th>Sent</th>
+                <th>Expires</th>
+                <th></th>
+              </tr>
+            </thead>
+            <tbody>
+              {invites.map((invite) => {
+                const s = status(invite)
+                return (
+                  <tr key={invite.id}>
+                    <td>{invite.email}</td>
+                    <td>{invite.role}</td>
+                    <td>
+                      <span className={`badge ${s.cls}`}>{s.label}</span>
+                    </td>
+                    <td>{new Date(invite.created_at).toLocaleDateString()}</td>
+                    <td>{new Date(invite.expires_at).toLocaleDateString()}</td>
+                    <td>
+                      {!invite.accepted_at && (
+                        <button className="danger" onClick={() => handleRevoke(invite.id)}>
+                          Revoke
+                        </button>
+                      )}
+                    </td>
+                  </tr>
+                )
+              })}
+            </tbody>
+          </table>
+        )}
+      </div>
+    </div>
+  )
+}
