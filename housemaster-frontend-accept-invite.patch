+// The invite preview/accept endpoints are public (no account exists yet),
+// so they skip the authenticated `request` wrapper entirely rather than
+// relying on it to "just not send a header" — that keeps them working the
+// same way whether or not someone happens to have stale tokens sitting in
+// localStorage from a previous session on the same browser.
+async function parseJsonResponse(res) {
+  let data = null
+  try {
+    data = await res.json()
+  } catch {
+    // no body
+  }
+  if (!res.ok) {
+    const message =
+      (data && (data.detail || Object.values(data).flat().join(' '))) ||
+      `Request failed (${res.status})`
+    throw new Error(message)
+  }
+  return data
+}
+
+async function previewInvite(token) {
+  const res = await fetch(`${API_BASE}/api/invites/preview/${token}/`)
+  return parseJsonResponse(res)
+}
+
+async function acceptInvite(token, { username, password }) {
+  const res = await fetch(`${API_BASE}/api/invites/accept/${token}/`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ username, password }),
+  })
+  const data = await parseJsonResponse(res)
+  setTokens({ access: data.access, refresh: data.refresh })
+  return data
+}
